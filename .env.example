# =============================================================================
# MarketMind Sim — environment variable template
# =============================================================================
# Copy this file to ".env" and fill in keys only if you need LLM/RAG engines:
#
#     cp .env.example .env        # macOS/Linux
#     copy .env.example .env      # Windows
#
# IMPORTANT: nothing here is required for the core experience.
#   - The web interface, Rule-engine scenarios, replay ("Load Results"),
#     Run Analysis and Agent Reasoning all work fully OFFLINE with no key.
#   - LLM / RuleLLM scenarios call an external chat model API.
#   - RAG scenarios additionally need embedding / parsing keys.
# Never commit your real .env (it is git-ignored).
# =============================================================================

# ── LLM scenarios (LLM / RuleLLM) ──────────────────────────────────────────
# Volcano Engine / Doubao (Ark) API key used by the bundled LLM scenarios.
ARK_API_KEY=

# ── RAG scenarios only (optional) ──────────────────────────────────────────
# Tencent Hunyuan embeddings (alternative embedding provider).
HUNYUAN_API_KEY=

# MinerU document parsing API (used by some RAG ingestion pipelines).
MINERU_API_KEY=

# ── Interface / runtime tuning (optional) ──────────────────────────────────
# UI language: en_US (default) or zh_CN.
MASIM_LOCALE=en_US

# Explicit Python interpreter for the Ray simulation worker, e.g.
#   Windows : MASIM_WORKER_PYTHON=C:\Users\you\miniconda3\envs\masim\python.exe
#   macOS   : MASIM_WORKER_PYTHON=/Users/you/miniconda3/envs/masim/bin/python
# Leave unset to auto-detect (current interpreter, then CONDA_PREFIX, then
# common Conda install locations).
# MASIM_WORKER_PYTHON=

# Override the number of CPUs Ray may use for a simulation.
# MASIM_RAY_NUM_CPUS=4
